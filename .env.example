# Givy env template — copy to `.env.local`

# Optional: leave blank to run local browser storage + demo sign-in.
# Fill both to enable Supabase cloud auth + shared lists.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL (OG tags, sitemap). Use your Render URL in production.
NEXT_PUBLIC_SITE_URL=https://givy.onrender.com

# Google OAuth client ID (also paste into Supabase → Auth → Google)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional closed beta: require invite code after sign-in (Next middleware)
# AND Postgres write gate (migration 006). Set true for closed beta.
NEXT_PUBLIC_BETA_REQUIRE_INVITE=true
# After enabling, run:
#   003_security_hardening.sql
#   004_beta_invites_intentional_rls.sql
#   006_beta_write_gate.sql
# in the Supabase SQL editor.

# --- Payments (Support me / tips) ---
# Givy does not process cards. Creators paste a PayPal.me (or allowlisted
# tip) URL on their list; guests tip on PayPal’s hosted pages.
# Optional: your own PayPal.me for docs/examples only — not required at build.
# NEXT_PUBLIC_PAYPAL_ME_EXAMPLE=https://www.paypal.com/paypalme/yourname
#
# E2E: Playwright uses PLAYWRIGHT_BASE_URL or starts `npm run dev` on :3000.
# PLAYWRIGHT_BASE_URL=https://givy.onrender.com

# --- AI gift suggestions (optional) ---
# Leave blank to use curated offline ideas by occasion (create/manage still work).
# OPENAI_API_KEY=
# Optional OpenAI-compatible base URL (default https://api.openai.com/v1)
# OPENAI_BASE_URL=
# Optional model (default gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

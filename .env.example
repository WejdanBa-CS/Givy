# Givy env template — copy to `.env.local`

# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Google OAuth client ID (public) — paste the same value into
# Supabase → Authentication → Providers → Google
# Client secret stays ONLY in the Supabase dashboard (never in this repo).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=552935596182-1n0j8f9fnk7sdorn177r1m0jlrkfla0p.apps.googleusercontent.com

# Givy env template — copy to `.env.local`

# Optional: leave blank to run local browser storage + demo sign-in.
# Fill both to enable Supabase cloud auth + shared lists.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL (OG tags, sitemap). Production: https://www.givy.gifts
NEXT_PUBLIC_SITE_URL=https://www.givy.gifts

# Google OAuth client ID (also paste into Supabase → Auth → Google)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Closed beta invite gate (middleware + UX). false = public signup.
# Even when false, run supabase/ops/open_public_signup.sql once so DB writes work.
NEXT_PUBLIC_BETA_REQUIRE_INVITE=false
# Guest mode: set true only for intentional demo environments.
# NEXT_PUBLIC_ALLOW_GUEST=false
# After enabling invite gate (true), run in Supabase SQL editor (if not already):
#   003_security_hardening.sql
#   004_beta_invites_intentional_rls.sql
#   006_beta_write_gate.sql
#   008_claim_orphan_and_limits.sql
#   009_claim_notifications.sql

# --- Payments (Support me / tips) ---
# Givy does not process cards. Creators paste a PayPal.me (or allowlisted
# tip) URL on their list; guests tip on PayPal’s hosted pages.
# Optional: your own PayPal.me for docs/examples only — not required at build.
# NEXT_PUBLIC_PAYPAL_ME_EXAMPLE=https://www.paypal.com/paypalme/yourname
#
# E2E: Playwright uses PLAYWRIGHT_BASE_URL or starts `npm run dev` on :3000.
# PLAYWRIGHT_BASE_URL=https://www.givy.gifts

# --- AI gift recommendations (optional) ---
# Used by /api/gift-suggestions and /api/ai/recommend-gifts
#
# Free option — Groq (OpenAI-compatible):
#   1. Create a key at https://console.groq.com/keys
#   2. On Render set:
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.1-8b-instant
#
# Paid OpenAI (optional):
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# Leave all blank to use free curated/catalog ideas only (no external AI).

# --- Error monitoring (Sentry) ---
# Set these in Render for each service. The DSN is public client configuration;
# SENTRY_AUTH_TOKEN is server/build-only and is only needed for source-map uploads.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# SENTRY_AUTH_TOKEN=

# --- Skimlinks (OFF by default — do not enable until domain is approved) ---
# A bad/unapproved publisher ID rewrites shop links into downloads.
# NEXT_PUBLIC_SKIMLINKS_PUBLISHER_ID=
# NEXT_PUBLIC_SKIMLINKS_ENABLED=true

# --- Claim notifications (optional email to list owner) ---
# After someone claims a gift, owners always get an in-app alert.
# To also email them, set both:
# SUPABASE_SERVICE_ROLE_KEY=   # Supabase → Settings → API (server only, never public)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Givy <hello@givy.gifts>
#
# Also run supabase/migrations/009_claim_notifications.sql in the SQL editor.

# Givy env template — copy to `.env.local`

# Optional: leave blank to run local demo mode (browser storage + demo OAuth).
# Fill both to enable Supabase cloud auth + shared lists.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth client ID (also paste into Supabase → Auth → Google)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=552935596182-1n0j8f9fnk7sdorn177r1m0jlrkfla0p.apps.googleusercontent.com

# Optional closed beta: require invite code after Google sign-in
# NEXT_PUBLIC_BETA_REQUIRE_INVITE=true
